# Ce que setuptools embarque dans le sdist en plus du paquet lui-meme.
#
# Sans cette ligne, setuptools ramasse tests/test_*.py mais pas
# tests/helpers.py : les tests du sdist ne demarraient meme pas.
recursive-include tests *.py

# tests/test_canari.py charge tools/canari.py par son chemin : sans lui, la
# suite du sdist ne demarrerait pas non plus.
recursive-include tools *.py

include CHANGELOG.md
