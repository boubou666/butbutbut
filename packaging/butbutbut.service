# Unite systemd utilisateur (modele).
# install.sh en genere automatiquement une version avec les bons chemins dans
# ~/.config/systemd/user/butbutbut.service. Ce fichier sert de reference si tu
# preferes l'ecrire a la main :
#
#   cp packaging/butbutbut.service ~/.config/systemd/user/butbutbut.service
#   $EDITOR ~/.config/systemd/user/butbutbut.service   # ajuste ExecStart
#   systemctl --user daemon-reload
#   systemctl --user reenable butbutbut.service
#   systemctl --user restart butbutbut.service

[Unit]
Description=butbutbut - alerte de buts des 5 grands championnats
# Surtout pas default.target : il demarre avec le gestionnaire utilisateur,
# avant que la session ne publie DISPLAY et WAYLAND_DISPLAY. Sous Plasma,
# remplacer les deux lignes par plasma-workspace.target, que la publication de
# ces variables accompagne.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/butbutbut --position bottom-right --interval 25 --quiet
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
